<!--
    RTI Connext DDS — CAMEO System Modeler 2024x Plugin Descriptor
    Plugin ID  : com.rti.connext.cameo
    Place this folder at:
        <CAMEO_HOME>\plugins\com.rti.connext.cameo\
-->
<plugin id="com.rti.connext.cameo"
        name="RTI Connext DDS"
        version="1.0.0"
        provider-name="Real-Time Innovations"
        class="com.rti.connext.cameo.RTIConnextPlugin">

    <requires>
        <api version="1.0"/>
    </requires>

    <!--
        lib/RTIConnextPlugin.jar  — built by build.bat from src/
        lib/nddsjava.jar          — copied from %NDDSHOME%\lib\java\ by build.bat
    -->
    <runtime>
        <library name="lib/RTIConnextPlugin.jar"/>
        <library name="lib/nddsjava.jar"/>
    </runtime>

</plugin>
