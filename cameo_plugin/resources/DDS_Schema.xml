<?xml version="1.0" encoding="UTF-8"?>
<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://community.rti.com/schema/7.5.0/rti_routing_service.xsd" version="7.5.0">
    <types>
      <struct name="SensorReport" extensibility="appendable">
        <member name="declared_id" type="string"/>
        <member name="sensor_id" type="string"/>
        <member name="measurement_time" type="string"/>
        <member name="measurement_frame" type="string"/>
        <member name="range_m" type="float64"/>
        <member name="bearing_rad" type="float64"/>
        <member name="elevation_rad" type="float64"/>
        <member name="doppler_mps" type="float64"/>
        <member name="snr_db" type="float64"/>
        <member name="quality_flag" type="boolean"/>
        <member name="sensor_modality" type="string"/>
        <member name="object_class_hint" type="string"/>
        <member name="reference_point" type="string"/>
      </struct>
      <struct name="Health" extensibility="appendable">
        <member name="service_state" type="string"/>
        <member name="cycle_report_count" type="int32"/>
        <member name="cycle_gated_count" type="int32"/>
        <member name="cycle_rejected_count" type="int32"/>
        <member name="anomalous_sensors" type="string"/>
        <member name="processing_latency_ms" type="float64"/>
        <member name="registered_sensor_count" type="int32"/>
      </struct>
    </types>

    <qos_library name="QosLibrary">
      <qos_profile name="ShapeQosProfile" is_default_qos="true">
        <domain_participant_qos>
          <participant_name>
            <name>ShapesDemo</name>
          </participant_name>
        </domain_participant_qos>
        <datareader_qos>
          <history>
            <depth>6</depth>
          </history>
        </datareader_qos>
      </qos_profile>
    </qos_library>

    <domain_library name="DomainLibrary">
      <domain name="Domain" domain_id="0">
        <register_type name="SensorReport_Type" type_ref="SensorReport"/>
        <register_type name="Health_Type" type_ref="Health"/>
        <topic name="SensorReport" register_type_ref="SensorReport_Type"/>
        <topic name="Health" register_type_ref="Health_Type"/>
      </domain>
    </domain_library>

    <domain_participant_library name="DomainParticipantLibrary">
      <domain_participant name="Sensor Alignment and Gating Service_Definition" domain_ref="DomainLibrary::Domain">
        <publisher name="Publisher">
          <data_writer name="HealthWriter" topic_ref="Health"/>
        </publisher>
        <subscriber name="Subscriber">
          <data_reader name="SensorReportReader" topic_ref="SensorReport"/>
        </subscriber>
      </domain_participant>
      <domain_participant name="Sensor Alignment and Gating Service_Implementation" domain_ref="DomainLibrary::Domain">
        <subscriber name="Subscriber">
          <data_reader name="HealthReader" topic_ref="Health"/>
        </subscriber>
      </domain_participant>
    </domain_participant_library>
</dds>
